# Copy to .env and fill in. `docker compose up` refuses to start while any of the
# three secrets below is empty. .env is gitignored — never commit it.

# Generate each with: openssl rand -hex 32
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# How many backend instances to run behind nginx (round-robin). Minimum 2 to
# see messages cross instances. Change it and run `docker compose up -d` again.
BACKEND_REPLICAS=2

# The only port published on the host — nginx. Phones reach the app here:
#   http://<your-LAN-address>:80
PUBLIC_PORT=80

# Optional. Without these the app runs, but sending a photo snap fails (S3 is
# not part of the compose stack).
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
